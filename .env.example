# Copy this file to ".env" (same folder as server.py) and fill in your details.
# .env is private: it is never served to visitors and is ignored by git.

# --- Email (needed to send sign-up, sign-in and password reset codes) ---
# Gmail: turn on 2-Step Verification for your Google account, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
# Use the app password here, never your normal Gmail password.
SAOMI_SMTP_HOST=smtp.gmail.com
SAOMI_SMTP_PORT=587
SAOMI_SMTP_USER=yourname@gmail.com
SAOMI_SMTP_PASSWORD=your-16-character-app-password
SAOMI_MAIL_FROM=Saomi <yourname@gmail.com>

# --- Site ---
# The address people use to reach the site (used for links inside emails).
SAOMI_SITE_URL=http://127.0.0.1:5500
# SAOMI_HOST=127.0.0.1
# SAOMI_PORT=5500
